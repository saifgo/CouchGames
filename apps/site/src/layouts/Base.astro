---
import '../styles/global.css';
import Bar from '../components/Bar.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';

interface Props {
  title: string;
  description: string;
  /** Hide the top bar until the hero has scrolled past (home page). */
  barHidden?: boolean;
  barTone?: string;
  jsonLd?: object[];
  ogImage?: string;
}
const { title, description, barHidden = false, barTone = 'cream', jsonLd = [], ogImage = '/og.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), SITE.url).href;
const og = new URL(ogImage, SITE.url).href;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.developer,
  url: SITE.url,
  logo: new URL('/app-icon-512.png', SITE.url).href,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1C1814" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/app-icon-512.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/fredoka-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CouchPad" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CouchPad: your phones are the controllers." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <script is:inline>document.documentElement.classList.add('js')</script>
    <script type="application/ld+json" set:html={JSON.stringify([org, ...jsonLd])} />
  </head>
  <body id="top">
    <a class="skip" href="#main">Skip to content</a>
    <Bar hidden={barHidden} tone={barTone} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
